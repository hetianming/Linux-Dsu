<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Win11Emu" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/win11_blue</item>
        <item name="colorPrimaryVariant">@color/win11_dark_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    
    <style name="Theme.Win11Emu.Boot" parent="Theme.Win11Emu">
        <item name="android:windowBackground">@drawable/boot_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    
    <style name="Theme.Win11Emu.Desktop" parent="Theme.Win11Emu">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
</resources>
