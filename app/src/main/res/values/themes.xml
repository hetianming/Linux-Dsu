<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:forceDarkAllowed">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F5F6FB</item>
    </style>

    <!--
        gunyahVM 页面专用：关闭 forceDark。
        该页面所有颜色都是代码按 Ui.isDark 自行绘制的，若系统深色模式再叠加一次
        自动反色（forceDark），会出现「浅卡 + 白字」「深字 + 深卡」的错乱，文字直接看不见。
    -->
    <style name="Theme.App.Gunyah" parent="Theme.App">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="Theme.App.Terminal" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:forceDarkAllowed">true</item>
        <item name="android:windowBackground">#241F1B</item>
        <item name="android:colorBackground">#241F1B</item>
        <item name="android:navigationBarColor">#241F1B</item>
        <item name="android:statusBarColor">#241F1B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- 小窗口样式：浮窗居中显示，四周半透明变暗，点外部关闭 -->
    <style name="Theme.App.SmallWindow" parent="Theme.App">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
