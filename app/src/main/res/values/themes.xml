<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:forceDarkAllowed">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F5F6FB</item>
    </style>

    <!--
        VM 页面族（含内嵌 tab 与各子 Activity）：仅关闭系统 forceDark，不带任何独立配色。
        v2.0.30 起所有颜色 / 卡片 / 按钮都由全局 Ui 转发层（GunTheme）按 Ui.isDark 绘制，
        与 APP 主界面完全同步；若系统深色模式再叠加一次自动反色会出现文字看不清，故关之。
    -->
    <style name="Theme.App.Gunyah" parent="Theme.App">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="Theme.App.Terminal" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:forceDarkAllowed">true</item>
        <item name="android:windowBackground">#241F1B</item>
        <item name="android:colorBackground">#241F1B</item>
        <item name="android:navigationBarColor">#241F1B</item>
        <item name="android:statusBarColor">#241F1B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- 小窗口样式：浮窗居中显示，四周半透明变暗，点外部关闭 -->
    <style name="Theme.App.SmallWindow" parent="Theme.App">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
