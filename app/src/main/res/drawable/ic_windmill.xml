<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- 上叶：蓝绿渐变 -->
    <path
        android:pathData="M24,24 L24,4 C33,8 36,16 24,24 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="24" android:startY="4"
                android:endX="36"  android:endY="24">
                <item android:offset="0" android:color="#FF8ED2F0" />
                <item android:offset="1" android:color="#FFB9E8F5" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 右叶：绿色 -->
    <path
        android:pathData="M24,24 L44,24 C40,33 32,36 24,24 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="24" android:startY="16"
                android:endX="44"  android:endY="32">
                <item android:offset="0" android:color="#FF9FEBC4" />
                <item android:offset="1" android:color="#FF6ED8A0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 下叶：蓝绿渐变（对角） -->
    <path
        android:pathData="M24,24 L24,44 C15,40 12,32 24,24 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="12" android:startY="24"
                android:endX="24"  android:endY="44">
                <item android:offset="0" android:color="#FF8ED2F0" />
                <item android:offset="1" android:color="#FFB9E8F5" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 左叶：绿色（对角） -->
    <path
        android:pathData="M24,24 L4,24 C8,15 16,12 24,24 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="4"  android:startY="24"
                android:endX="24"   android:endY="36">
                <item android:offset="0" android:color="#FF6ED8A0" />
                <item android:offset="1" android:color="#FF9FEBC4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 中心圆帽 -->
    <path
        android:fillColor="#FFD4F5E8"
        android:pathData="M27,24 a3,3 0 1 1 -6,0 a3,3 0 1 1 6,0 z" />
</vector>
